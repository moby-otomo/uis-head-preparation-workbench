{
  "schemaVersion": "uis.head-preparation.quick-pixelize-config/1",
  "algorithmVersion": "1.0.0",
  "alpha": {
    "mode": "clear-at-or-below",
    "threshold": 15
  },
  "bounds": {
    "mode": "normalized-alpha-content"
  },
  "target": {
    "width": 96,
    "height": 96,
    "fit": "contain"
  },
  "resampling": "nearest-neighbor",
  "transparentPadding": {
    "top": 2,
    "right": 2,
    "bottom": 2,
    "left": 2
  },
  "pngEncoding": {
    "colorType": "rgba",
    "bitDepth": 8,
    "filterType": 0,
    "deflateLevel": 9,
    "deflateStrategy": 3
  }
}
