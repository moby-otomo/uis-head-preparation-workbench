{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moby-otomo.local/schemas/head-preparation/v1/validation-report.schema.json",
  "title": "UIS Head Preparation Validation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "subject",
    "outcome",
    "coreOutcome",
    "compatibilityOutcome",
    "validatorVersion",
    "createdAt",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": "uis.head-preparation.validation-report/1" },
    "kind": { "const": "validation-report" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["source-asset", "candidate-asset", "compatibility-profile"] },
        "id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "outcome": { "enum": ["pass", "fail", "unverified"] },
    "coreOutcome": { "enum": ["pass", "fail"] },
    "compatibilityOutcome": { "enum": ["pass", "fail", "unverified", "not-applicable"] },
    "compatibilityProfileId": { "$ref": "common.schema.json#/$defs/id" },
    "validatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "code", "severity", "message"],
        "properties": {
          "layer": {
            "enum": ["schema", "binary", "hash", "lineage", "direction", "lifecycle", "policy", "compatibility"]
          },
          "code": { "$ref": "common.schema.json#/$defs/id" },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
