{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moby-otomo.local/schemas/head-preparation/v1/fixture.schema.json",
  "title": "UIS Head Preparation Fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "identity",
    "fixtureType",
    "artifactStatus",
    "directions",
    "purpose",
    "productionExportAllowed"
  ],
  "properties": {
    "schemaVersion": { "const": "uis.head-preparation.fixture/1" },
    "kind": { "const": "fixture" },
    "id": { "type": "string", "pattern": "^TEST_[A-Za-z0-9._-]+$" },
    "identity": { "$ref": "common.schema.json#/$defs/identity" },
    "fixtureType": { "enum": ["artistic-calibration", "protocol-synthetic"] },
    "artifactStatus": { "enum": ["contract-only", "available"] },
    "expectedSourceFilename": { "$ref": "common.schema.json#/$defs/portablePath" },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction", "originalFilename", "provenance", "artifact"],
        "properties": {
          "direction": { "$ref": "common.schema.json#/$defs/direction" },
          "originalFilename": { "$ref": "common.schema.json#/$defs/portablePath" },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["artist-authored", "mirror-derived"] },
              "sourceDirection": { "$ref": "common.schema.json#/$defs/direction" },
              "pixelExactToCurrentSource": { "type": "boolean" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "kind": { "const": "mirror-derived" } },
                  "required": ["kind"]
                },
                "then": {
                  "properties": {
                    "sourceDirection": { "$ref": "common.schema.json#/$defs/direction" },
                    "pixelExactToCurrentSource": { "type": "boolean" }
                  },
                  "required": ["sourceDirection", "pixelExactToCurrentSource"]
                }
              }
            ]
          },
          "artifact": { "$ref": "common.schema.json#/$defs/imageArtifact" }
        }
      }
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/direction" }
    },
    "purpose": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requiredVisualTraits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "intentionalOmissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "knownRasterCharacteristics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "productionExportAllowed": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "artifactStatus": { "const": "available" } },
        "required": ["artifactStatus"]
      },
      "then": {
        "properties": { "sourceArtifacts": { "type": "array", "minItems": 1 } },
        "required": ["sourceArtifacts"]
      }
    }
  ]
}
